# Copy to .env locally. Never put keys in chat or source control.
GEMINI_API_KEY=
GEMINI_PLANNING_MODEL=gemini-3.8-flash
GEMINI_NUDGE_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore

# Optional: import the Desktop OAuth JSON from Settings instead of these variables.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GEMINI_ASSIGNMENT_MODEL=gemini-3.8-flash

# Assignment workspace chat (always uses Gemini)
GEMINI_CHAT_MODEL=gemini-3.8-flash
