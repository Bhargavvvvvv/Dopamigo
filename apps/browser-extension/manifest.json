{
  "manifest_version": 3,
  "name": "Dopamigo companion",
  "version": "0.1.0",
  "description": "Optional active-tab signals for an enabled Dopamigo focus session.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "worker.js" },
  "action": { "default_popup": "popup.html", "default_title": "Dopamigo — monitoring off" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:*" }
}
